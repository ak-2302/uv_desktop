{
  "name": "uv-desktop",
  "version": "0.1.0",
  "description": "A focused desktop GUI for uv Python projects",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron --import tsx ./src/main/main.ts\"",
    "build": "tsc -p tsconfig.electron.json && vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron-builder": "latest",
    "electron": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "tsx": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.uvdesktop.app",
    "productName": "uv Desktop",
    "files": ["dist/**/*", "dist-electron/**/*"],
    "directories": { "output": "release" }
  }
}
